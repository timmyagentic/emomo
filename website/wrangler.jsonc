{
  "name": "emomo-official",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/account/*"
    ]
  },
  "routes": [
    {
      "pattern": "timmyagentic.si",
      "custom_domain": true
    },
    {
      "pattern": "www.timmyagentic.si",
      "custom_domain": true
    }
  ],
  "main": "src/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_STORE",
        "class_name": "Account"
      },
      {
        "name": "ADMISSION",
        "class_name": "Admission",
        "script_name": "emomo-agent-search"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-accounts",
      "new_sqlite_classes": [
        "Account"
      ]
    }
  ],
  "vars": {
    "ACCOUNTS_ENABLED": "true",
    "SITE_ORIGINS": "https://timmyagentic.si,https://www.timmyagentic.si",
    "EMAIL_FROM": "login@mail.timmyagentic.si"
  },
  "secrets": {
    "required": [
      "ACCOUNT_SECRET"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "1010",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "limits": {
    "cpu_ms": 100
  }
}
