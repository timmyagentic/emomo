{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emomo-agent-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // No production route. Activation requires an explicit domain cutover.
  "vars": {
    "AGENT_API_ENABLED": "false",
    "IMAGE_BASE_URL": "https://r2.emomo.net"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "emomo-agent-index",
    // Local-only placeholder: replace after separately authorized provisioning.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "remote": false,
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "EMOMO_RATE_LIMITER",
    "namespace_id": "1002",
    "simple": { "limit": 30, "period": 60 }
  }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
