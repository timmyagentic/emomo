{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emomo-agent-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.timmyagentic.si", "custom_domain": true }],
  "vars": {
    "AGENT_API_ENABLED": "true",
    "IMAGE_BASE_URL": "https://images.timmyagentic.si"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "emomo-agent-index",
    // Dedicated production read model.
    "database_id": "576f07ac-6950-41fe-922f-637cface62f8",
    "remote": false,
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "EMOMO_RATE_LIMITER",
    "namespace_id": "1002",
    "simple": { "limit": 30, "period": 60 }
  }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
