{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emomo-image-downloads",
  "main": "src/download.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "images.timmyagentic.si",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "emomo-reviewed-public",
      "remote": false
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_STORE", "class_name": "Account", "script_name": "emomo-official" },
      {
        "name": "DOWNLOAD_IP_LIMITER",
        "class_name": "PerIpLimiter"
      },
      {
        "name": "ADMISSION",
        "class_name": "Admission",
        "script_name": "emomo-agent-search"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-per-ip-limit",
      "new_sqlite_classes": [
        "PerIpLimiter"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "secrets": {
    "required": [
      "ACCESS_KEYS_JSON"
    ]
  },
  "limits": {
    "cpu_ms": 50
  },
  "vars": {
    "SERVICE_PAUSED": "false",
    "GLOBAL_LIMITS_JSON": "{\"search\": {\"perSecond\": 10, \"perDay\": 5000, \"inFlight\": 10, \"failures\": 5, \"cooldownSeconds\": 30}, \"read\": {\"perSecond\": 30, \"perDay\": 20000, \"inFlight\": 30, \"failures\": 5, \"cooldownSeconds\": 30}, \"download\": {\"perSecond\": 10, \"perDay\": 5000, \"inFlight\": 10, \"failures\": 5, \"cooldownSeconds\": 30}}"
  }
}
